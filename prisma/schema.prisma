
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admins {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(150)
  email         String    @unique @db.VarChar(255)
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model applications {
  id               BigInt            @id @default(autoincrement())
  name             String            @db.VarChar(150)
  email            String            @db.VarChar(255)
  phone            String            @db.VarChar(20)
  location         String?           @db.VarChar(200)
  position         String            @db.VarChar(150)
  experience_level String?           @db.VarChar(50)
  resume_url       String
  status           String?           @default("NEW") @db.VarChar(30)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  follow_up_notes  follow_up_notes[]

  @@index([email], map: "idx_applications_email")
  @@index([position], map: "idx_applications_position")
  @@index([status], map: "idx_applications_status")
}

model follow_up_notes {
  id             BigInt        @id @default(autoincrement())
  lead_id        BigInt?
  application_id BigInt?
  note           String
  follow_up_date DateTime?     @db.Timestamp(6)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  applications   applications? @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leads          leads?        @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_followup_application")
  @@index([lead_id], map: "idx_followup_lead")
}

model leads {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(150)
  email           String            @db.VarChar(255)
  phone           String            @db.VarChar(20)
  company         String?           @db.VarChar(200)
  service         String?           @db.VarChar(150)
  message         String
  status          String?           @default("NEW") @db.VarChar(30)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)

  follow_up_notes follow_up_notes[]

  @@index([email], map: "idx_leads_email")
  @@index([status], map: "idx_leads_status")
}

model social_links {
  id         BigInt   @id @default(autoincrement())
  platform   String   @db.VarChar(50)
  url        String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
}
